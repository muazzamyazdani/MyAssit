# Copy to .env and fill in. Nothing in this repo loads .env automatically —
# it documents which credential goes into which n8n credential/node.

# --- Airtable ---
# Personal access token: airtable.com/create/tokens
# Needs scopes: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_PERSONAL_ACCESS_TOKEN=
# Base ID (starts with "app...") — leave blank to have the setup script create a new base
AIRTABLE_BASE_ID=
# Workspace ID (starts with "wsp...") — only needed if creating a brand new base
AIRTABLE_WORKSPACE_ID=

# --- Telegram ---
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=
# Your personal chat ID — send the bot any message, then check
# https://api.telegram.org/bot<token>/getUpdates to find it
TELEGRAM_CHAT_ID=

# --- OpenAI ---
# platform.openai.com — used for email/screenshot understanding, Whisper
# transcription, and TTS voice summaries
OPENAI_API_KEY=

# --- n8n ---
# Your n8n cloud instance URL, e.g. https://your-instance.app.n8n.cloud
N8N_HOST=
# Webhook base URL n8n gives you for the call-queue tel: redirect workflow
N8N_WEBHOOK_BASE_URL=
